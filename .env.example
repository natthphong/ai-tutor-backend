DATABASE_URL=postgres://toko:change-me@localhost:5432/toko_loop?sslmode=disable
GEMINI_API_KEY=
TOKO_CONFIG=config/models.yaml
AUDIO_DIR=./data/audio
PUBLIC_BACKEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
# Optional private MinIO object storage. Leave credentials empty in committed files.
# MINIO_ENDPOINT=minio.example.internal:9000
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ai-tutor
MINIO_USE_SSL=true
MINIO_PREFIX_TTS=tts/
MINIO_PREFIX_USER_AUDIO=user-audio/
# Per-user response cache and durable local audio replica defaults.
CACHE_TTL_SECONDS=30
CACHE_MAX_MB=32
AUDIO_LOCAL_CACHE_DAYS=3
# Optional deploy inputs: never commit .env.deploy
# PORTAINER_URL=http://home-server:9000
# PORTAINER_API_KEY=
# ENDPOINT_ID=3
# APP_NAME=ai-tutor
# EXTERNAL_PORT=8104
# RELEASE_ID=20260905-1
# DATABASE_BIND_IP=192.168.1.122
# DATABASE_HOST_PORT=15432
